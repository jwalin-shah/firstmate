{
  "schema_version": 1,
  "description": "Shared JSON scenario format for Firstmate protocol verification. Each scenario runs against the Go reference reducer, the production in-memory adapter, and (eventually) model-derived traces.",
  "scenario_template": {
    "schema_version": 1,
    "description": "human-readable name",
    "initial": {
