      "worker_capability": { "w1": ["go"], "w2": ["python"] }
    },
    "steps": [
      { "command": "Submit", "task": "t1" },
      { "command": "Reserve", "task": "t1", "attempt": "a1", "worker": "w1", "lease_epoch": 1 },
      { "command": "Dispatch", "task": "t1", "attempt": "a1", "lease_epoch": 1 },
      { "command": "Complete", "task": "t1", "attempt": "a1", "revision": 1, "lease_epoch": 1 },
      { "command": "VerifyPass", "task": "t1", "attempt": "a1", "revision": 1 }
    ],
    "expected_violation": null
  }
}
